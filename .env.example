# ==============================================
# CONFIGURAÇÃO DE AMBIENTE - DESAFIO RESTAURANTE
# ==============================================
# Copie este arquivo para .env e configure os valores

# ==============================================
# SERVER
# ==============================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ==============================================
# SECURITY
# ==============================================
# JWT Secret: Use uma string aleatória forte (mínimo 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Expiration (exemplos: 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# BCrypt Rounds (10-12 para produção, mais = mais seguro mas mais lento)
BCRYPT_ROUNDS=10

# ==============================================
# DATABASE
# ==============================================
DB_TYPE=sqlite
DB_PATH=./database/database.sqlite

# ==============================================
# CORS
# ==============================================
# Liste as origens permitidas separadas por vírgula
# Exemplo: http://localhost:3000,http://localhost:3001,https://seu-dominio.com
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ==============================================
# RATE LIMITING
# ==============================================
# Janela de tempo em milissegundos (900000 = 15 minutos)
RATE_LIMIT_WINDOW=900000

# Máximo de requisições por janela
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# LOGGING
# ==============================================
# Níveis: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Caminho do arquivo de log
LOG_FILE_PATH=./logs/app.log

# ==============================================
# PRODUÇÃO - CONFIGURAÇÕES ADICIONAIS
# ==============================================
# Descomente e configure para produção

# Database (PostgreSQL, MySQL, etc)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=restaurante
# DB_USER=postgres
# DB_PASSWORD=your-strong-password

# Redis (para rate limiting distribuído)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# Email (para notificações)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# AWS S3 (para upload de arquivos)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name
