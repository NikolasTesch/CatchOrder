{
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.rulers": [
        100
    ],
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/*.js": {
            "when": "$(basename).ts"
        },
        "**/*.map": {
            "when": "$(basename)"
        }
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true
    },
    "typescript.tsdk": "node_modules/typescript/lib"
}